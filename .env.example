APP_NAME=FlareWeber
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flareweber
DB_USERNAME=flareweber
DB_PASSWORD=flareweber

QUEUE_CONNECTION=database

# Cloudflare OAuth app (create at https://dash.cloudflare.com/?to=/:account/api/oauth-apps)
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_SECRET=
CLOUDFLARE_OAUTH_REDIRECT_URI="${APP_URL}/flareweber/cloudflare/callback"
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# Minimum scopes; ResourceProvisioner needs Workers scripts + D1 + R2 + zone read + custom domains
CLOUDFLARE_OAUTH_SCOPES="user.read workers:write workers_routes:write workers_tail:read d1:write r2:write zone:read ssl_cert:write"

# Stripe Connect (platform keys; per-site accounts are connected OAuth)
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Worker template build
WORKER_TEMPLATE_PATH=worker
WORKER_ACCOUNT_ID_FALLBACK=
