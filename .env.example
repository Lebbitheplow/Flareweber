APP_NAME=FlareWeber
APP_ENV=local
# APP_KEY is generated by docker/entrypoint.sh into app/.env on first boot.
# Do not set a blank APP_KEY= here: compose would export it and shadow the
# generated key. Only uncomment to pin one deliberately.
# APP_KEY=base64:...
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flareweber
DB_USERNAME=flareweber
DB_PASSWORD=flareweber

# Cloudflare OAuth app (create at https://dash.cloudflare.com/?to=/:account/api/oauth-apps)
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_SECRET=
CLOUDFLARE_OAUTH_REDIRECT_URI="${APP_URL}/flareweber/cloudflare/callback"
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# OAuth scopes requested when a Cloudflare OAuth client is configured (optional; API tokens work without it)
CLOUDFLARE_OAUTH_SCOPES="account:read user:read workers:write workers_scripts:write d1:write r2:write zone:read dns_records:write workers_routes:write ssl_certs:write offline_access"

# Stripe Connect (platform keys; per-site accounts are connected OAuth)
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Worker template (absolute path inside the container; docker-compose.yml
# sets the same value so it does not depend on the working directory)
WORKER_TEMPLATE_PATH=/var/www/flareweber/worker
WORKER_ACCOUNT_ID_FALLBACK=
