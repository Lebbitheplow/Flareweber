{
  "name": "flareweber-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "bundle": "npx --yes esbuild@0.25 src/index.ts --bundle --format=esm --platform=neutral --outfile=dist/worker.mjs --minify",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute site-db --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.0.0"
  }
}
